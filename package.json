{
  "name": "pokemon-master-trainer",
  "version": "2.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit --incremental false",
    "audit:source": "node tools/audit-source-usage.mjs",
    "test:arena-status": "node tools/test-arena-status.mjs",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "serve dist -s -n -L -p $PORT",
    "test:combat": "node --import tsx --test tests/emerald-engine.test.ts tests/statusCleanup.test.ts tests/fullRestore.test.ts tests/full-restore-restrictions.test.ts tests/trainer-battle.test.ts tests/trainer-items.test.ts tests/trainer-session.test.ts tests/future-sight-native.test.ts tests/legacy-delayed-attacks.test.ts tests/npc-delayed-moves.test.ts && node tools/test-emerald-browser.mjs && node tools/test-trainer-browser.mjs && node tools/test-trainer-privacy.mjs",
    "catalog:emerald": "node tools/build-emerald-catalog.mjs",
    "test:messages:browser": "node tools/test-messages-browser.mjs",
    "test:users:browser": "node tools/test-users-browser.mjs",
    "test:accounts": "node tools/test-account-storage.mjs",
    "test:pvp:engine": "node --import tsx --test tests/pvp-engine.test.ts",
    "test:pvp:party": "node tools/test-account-storage.mjs --pvp",
    "test:pvp:browser": "node tools/test-pvp-browser.mjs",
    "test:trainer:catalog": "node --import tsx --test tests/kanto-trainers.test.ts",
    "test:trainer:browser": "node tools/test-pvp-browser.mjs",
    "test:future-sight": "node --import tsx --test tests/future-sight-native.test.ts tests/legacy-delayed-attacks.test.ts tests/npc-delayed-moves.test.ts",
    "test:shop:wallet": "node tools/test-account-storage.mjs --shop",
    "test:shop:ui": "node --import tsx --test tests/admin-shop.test.ts",
    "test:pp": "node --import tsx --test tests/move-pp-items.test.ts tests/legacy-pp.test.ts tests/pvp-engine.test.ts",
    "test:tm": "node --import tsx --test tests/tm-plan.test.ts && node tools/test-account-storage.mjs --shop",
    "test:shop:browser": "node tools/test-pvp-browser.mjs --shop-only",
    "test:back-office:browser": "node tools/test-pvp-browser.mjs --back-office-only",
    "test:center:browser": "node tools/test-pvp-browser.mjs --center-only",
    "test:capture": "node --import tsx --test tests/captureRates.test.ts tests/capture-turn.test.ts && node tools/test-account-storage.mjs --shop",
    "test:capture:browser": "node tools/test-pvp-browser.mjs --capture-only",
    "test:opponent-auto": "node --import tsx --test tests/opponent-automation.test.ts",
    "test:opponent-auto:browser": "node tools/test-pvp-browser.mjs --opponent-auto-only",
    "test:gifts": "node tools/test-account-storage.mjs --shop",
    "test:gifts:browser": "node tools/test-pvp-browser.mjs --gift-only"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.2.0",
    "@pkmn/sim": "0.10.11",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.6",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.525.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.45.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.11.2",
    "redux-persist": "^6.0.0",
    "serve": "^14.2.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.6",
    "zod": "^3.22.1"
  },
  "devDependencies": {
    "@types/node": "^20.5.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@types/react-test-renderer": "18.3.2",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.39.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "framer-motion": "^10.16.0",
    "postcss": "^8.4.23",
    "prettier": "3.6.2",
    "react-test-renderer": "18.2.0",
    "tailwindcss": "^3.3.2",
    "tsx": "4.20.6",
    "typescript": "^5.1.6",
    "vite": "^4.3.1"
  }
}
